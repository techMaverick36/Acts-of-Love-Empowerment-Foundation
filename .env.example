# Copy to .env and fill in. All values are public client keys (they ship in the
# browser bundle); access is controlled by EmailJS and Supabase settings.

# EmailJS — contact + volunteer forms (see README → "Forms (EmailJS)")
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Supabase — blog + admin (see supabase/README.md)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
